{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "TokenizeTest",
            "request": "launch",
            "mainClass": "nl.structs.TokenizeTest",
            "projectName": "Searcher"
        },
        {
            "type": "java",
            "name": "Enlight",
            "request": "launch",
            "mainClass": "nl.structs.Enlight",
            "args": [
                "-path",
                "./data",
                "-port",
                "8080"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "Debug Enlight",
            "request": "launch",
            "mainClass": "nl.structs.Enlight",
            "args": [
                "-path",
                "./data",
                "-port",
                "8080"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "Attach Enlight (5005)",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005
        }
    ]
}